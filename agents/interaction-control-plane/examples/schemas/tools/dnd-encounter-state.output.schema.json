{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/tools/dnd-encounter-state.output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "operation_id", "campaign_id", "encounter_id", "version", "status", "round", "active_index", "participants"],
  "properties": {
    "previous_state": {
      "type": "object", "additionalProperties": false,
      "required": ["campaign_id", "encounter_id", "version", "status", "round", "active_index", "participants"],
      "properties": {
        "campaign_id": {"$ref": "#/properties/campaign_id"},
        "encounter_id": {"$ref": "#/properties/encounter_id"},
        "version": {"$ref": "#/properties/version"},
        "status": {"const": "active"},
        "round": {"$ref": "#/properties/round"},
        "active_index": {"$ref": "#/properties/active_index"},
        "participants": {"$ref": "#/properties/participants"}
      }
    },
    "operation": {"type": "string", "enum": ["start", "get", "add", "remove", "advance", "end", "damage", "heal", "condition_add", "condition_remove", "roll_initiative"]},
    "campaign_version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "campaign_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "initiative_rolls": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["character_id", "expression", "rolls", "kept_indices", "total", "entropy_source"],
        "properties": {
          "character_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "expression": {"type": "string", "pattern": "^(1d20|2d20k[hl]1)([+]([1-7][0-9]?|[89]|80)|-([1-9][0-9]?|10[01]))?$"},
          "rolls": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 20}},
          "kept_indices": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 1}},
          "total": {"type": "integer", "minimum": -100, "maximum": 100},
          "entropy_source": {"const": "getrandom"}
        }
      }
    },
    "operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "encounter_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["active", "ended"]},
    "round": {"type": "integer", "minimum": 1},
    "active_index": {"type": "integer", "minimum": -1},
    "active_participant_id": {"type": "string", "pattern": "^([A-Za-z0-9][A-Za-z0-9._:-]{0,127})?$"},
    "participant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "amount": {"type": "integer", "minimum": 1, "maximum": 100000},
    "damage_type": {"type": "string", "enum": ["acid", "bludgeoning", "cold", "fire", "force", "lightning", "necrotic", "piercing", "poison", "psychic", "radiant", "slashing", "thunder"]},
    "condition": {"type": "string", "enum": ["blinded", "charmed", "deafened", "frightened", "grappled", "incapacitated", "invisible", "paralyzed", "petrified", "poisoned", "prone", "restrained", "stunned", "unconscious"]},
    "participants": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "initiative", "max_hp", "current_hp", "conditions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "initiative": {"type": "integer", "minimum": -100, "maximum": 100},
          "max_hp": {"type": "integer", "minimum": 0, "maximum": 100000},
          "current_hp": {"type": "integer", "minimum": 0, "maximum": 100000},
          "conditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["blinded", "charmed", "deafened", "frightened", "grappled", "incapacitated", "invisible", "paralyzed", "petrified", "poisoned", "prone", "restrained", "stunned", "unconscious"]}}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"active_index": {"const": -1}}},
      "then": {"properties": {"active_participant_id": {"const": ""}}},
      "else": {"properties": {"active_participant_id": {"minLength": 1}}}
    },
    {
      "if": {"properties": {"operation": {"enum": ["advance", "end", "damage", "heal", "condition_add", "condition_remove"]}}},
      "else": {"properties": {"previous_state": false}}
    },
    {
      "if": {"properties": {"operation": {"const": "roll_initiative"}}},
      "then": {
        "required": ["campaign_version", "campaign_sha256", "initiative_rolls"],
        "properties": {"participants": {"minItems": 1, "maxItems": 64}}
      },
      "else": {"properties": {"campaign_version": false, "campaign_sha256": false, "initiative_rolls": false}}
    }
  ]
}
