{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/tools/dnd-dice-roll.input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["expression"],
  "properties": {
    "expression": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]?|100)d[1-9][0-9]{0,3}(?:(?:kh1|kl1))?(?:[+-][0-9]{1,5})?$"
    },
    "reason": {"type": "string", "maxLength": 240},
    "campaign_id": {"type": "string", "maxLength": 128},
    "actor_id": {"type": "string", "maxLength": 128},
    "visibility": {"type": "string", "enum": ["public", "dm", "private"], "default": "public"}
  }
}
