{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/tools/dnd-dice-roll.output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["roll_id", "expression", "rolls", "kept_indexes", "kept_rolls", "modifier", "total", "mode", "visibility", "entropy_source"],
  "properties": {
    "roll_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "expression": {"type": "string", "pattern": "^(?:[1-9][0-9]?|100)d[1-9][0-9]{0,3}(?:(?:kh1|kl1))?(?:[+-][0-9]{1,5})?$"},
    "rolls": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "integer", "minimum": 1, "maximum": 1000}},
    "kept_indexes": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 99}},
    "kept_rolls": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "integer", "minimum": 1, "maximum": 1000}},
    "modifier": {"type": "integer", "minimum": -10000, "maximum": 10000},
    "total": {"type": "integer", "minimum": -9999, "maximum": 110000},
    "mode": {"type": "string", "enum": ["normal", "advantage", "disadvantage"]},
    "reason": {"type": "string", "maxLength": 240},
    "campaign_id": {"type": "string", "maxLength": 128},
    "actor_id": {"type": "string", "maxLength": 128},
    "visibility": {"type": "string", "enum": ["public", "dm", "private"]},
    "entropy_source": {"const": "crypto/rand"}
  }
}
