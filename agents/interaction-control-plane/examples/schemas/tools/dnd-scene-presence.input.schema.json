{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.daviestechlabs.io/tools/dnd-scene-presence.input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "campaign_id",
    "scene_id",
    "character_name"
  ],
  "properties": {
    "operation": {
      "const": "resolve_scene_presence"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "character_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\x00-\\x20\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\x00-\\x20\\x7f])?$",
      "description": "At most 200 UTF-8 bytes. ASCII names compare without case; other bytes compare exactly."
    }
  }
}
