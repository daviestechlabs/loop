# Copy to loop.env. Set real origins and a private purpose-separated gateway key.
LOOP_AUTH_MODE=gateway
LOOP_ORIGIN=https://loop.example.com
LOOP_WEBTRANSPORT_URL=https://voice.example.com:8443/v1/voice/turns
LOOP_ANVIL_ORIGIN=https://anvil.example.com
LOOP_DB_MAX_BYTES=2147483648
SSO_ISSUER=https://auth.example.com/application/o/loop-demo/
SSO_AUDIENCE=loop-demo
SSO_REQUIRED_GROUP=loop-demo-users
SSO_JWKS_URL=https://auth.example.com/application/o/loop-demo/jwks/
VOICE_GATEWAY_TOKEN=
