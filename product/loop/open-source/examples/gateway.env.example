# Configure the existing C QUIC edge. This file starts no engine or execution controller.
GATEWAY_WEBTRANSPORT_AUTHORITY=voice.example.com:8443
GATEWAY_WEBTRANSPORT_PATH=/v1/voice/turns
GATEWAY_WEBTRANSPORT_ALLOWED_ORIGINS=https://loop.example.com
GATEWAY_WEBTRANSPORT_PORT=8443
GATEWAY_WEBTRANSPORT_CERT_FILE=/run/voice-tls/tls.crt
GATEWAY_WEBTRANSPORT_KEY_FILE=/run/voice-tls/tls.key
VOICE_GATEWAY_TOKEN=
